{
  "id": "textedit-select-all-replace",
  "app": "TextEdit",
  "category": "textedit",
  "goal": "Select everything in the TextEdit document and replace it with the word REPLACED.",
  "place": "host",
  "setup": {
    "requires": {
      "installed": [
        "TextEdit"
      ],
      "exclusive": [
        "TextEdit"
      ]
    },
    "files": {
      "doc.txt": "alpha beta gamma"
    },
    "open": [
      {
        "app": "TextEdit",
        "as": "doc",
        "targets": [
          "{tmp}/doc.txt"
        ],
        "title": "doc.txt"
      }
    ]
  },
  "steps": [
    {
      "do": "press",
      "window": "doc",
      "target": {
        "role": "textfield"
      },
      "key": "cmd+a"
    },
    {
      "do": "type",
      "window": "doc",
      "target": {
        "role": "textfield"
      },
      "text": "REPLACED"
    }
  ],
  "check": {
    "kind": "ax",
    "window": "doc",
    "target": {
      "role": "textfield"
    },
    "equals": "REPLACED"
  },
  "expected_fail": {
    "baneyspaces": {
      "phase": 4,
      "why": "phase 1 types through the accessibility tree only; keys refuse with not_supported until per-process keys ship"
    }
  }
}
