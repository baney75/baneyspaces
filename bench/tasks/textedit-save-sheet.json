{
  "id": "textedit-save-sheet",
  "app": "TextEdit",
  "category": "dialog",
  "goal": "Save the document draft.txt as a copy named saved-copy.txt in the same folder, using the Save As sheet.",
  "place": "host",
  "setup": {
    "requires": {
      "installed": [
        "TextEdit"
      ],
      "exclusive": [
        "TextEdit"
      ]
    },
    "files": {
      "draft.txt": "draft text"
    },
    "open": [
      {
        "app": "TextEdit",
        "as": "doc",
        "targets": [
          "{tmp}/draft.txt"
        ],
        "title": "draft.txt"
      }
    ]
  },
  "steps": [
    {
      "do": "press",
      "window": "doc",
      "target": {
        "role": "textfield"
      },
      "key": "cmd+shift+s"
    },
    {
      "do": "set-value",
      "window": "doc",
      "surfaces": [
        "window",
        "sheet"
      ],
      "target": {
        "role": "textfield",
        "name": "Save As"
      },
      "value": "saved-copy.txt"
    },
    {
      "do": "click",
      "window": "doc",
      "surfaces": [
        "window",
        "sheet"
      ],
      "target": {
        "role": "button",
        "name": "Save",
        "exact": true
      }
    },
    {
      "do": "wait",
      "ms": 600
    }
  ],
  "check": {
    "kind": "file",
    "path": "{tmp}/saved-copy.txt",
    "contains": "draft text"
  },
  "expected_fail": {
    "baneyspaces": {
      "phase": 4,
      "why": "phase 1 types through the accessibility tree only; keys refuse with not_supported until per-process keys ship"
    }
  }
}
