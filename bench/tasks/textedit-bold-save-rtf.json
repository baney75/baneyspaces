{
  "id": "textedit-bold-save-rtf",
  "app": "TextEdit",
  "category": "textedit",
  "goal": "Make all the text in the rich text document note.rtf bold and save the document.",
  "place": "host",
  "setup": {
    "requires": {
      "installed": [
        "TextEdit"
      ],
      "exclusive": [
        "TextEdit"
      ]
    },
    "files": {
      "note.rtf": {
        "rtf": true
      }
    },
    "open": [
      {
        "app": "TextEdit",
        "as": "doc",
        "targets": [
          "{tmp}/note.rtf"
        ],
        "title": "note.rtf"
      }
    ]
  },
  "steps": [
    {
      "do": "press",
      "window": "doc",
      "target": {
        "role": "textfield"
      },
      "key": "cmd+a"
    },
    {
      "do": "press",
      "window": "doc",
      "target": {
        "role": "textfield"
      },
      "key": "cmd+b"
    },
    {
      "do": "press",
      "window": "doc",
      "target": {
        "role": "textfield"
      },
      "key": "cmd+s"
    },
    {
      "do": "wait",
      "ms": 600
    }
  ],
  "check": {
    "kind": "file",
    "path": "{tmp}/note.rtf",
    "regex": "\\\\b[ \\\\]"
  },
  "expected_fail": {
    "baneyspaces": {
      "phase": 4,
      "why": "phase 1 types through the accessibility tree only; keys refuse with not_supported until per-process keys ship"
    }
  }
}
