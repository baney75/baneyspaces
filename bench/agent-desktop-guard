#!/usr/bin/env python3
"""A guard around the agent-desktop binary for the agent-desktop end-to-end column.

claude's Bash is allowed to run THIS file only. It forwards a command to the real binary
(BENCH_AD_BIN) when, and only when, the command stays inside the current task's windows
(BENCH_GUARD_FILE: {"windows": ["w-123", ...], "snapshots": [...]}):

  - the verb is a read or an act on a ref/window (no launch, close-app, clipboard, notifications, batch, ...);
  - every --window-id is one of the task's windows, and snapshot/find/press must name one;
  - --app, --headed and the desktop-wide surfaces (focused, dock, spotlight, ...) are refused;
  - every ref (@sXXXX:eN, also after --root and --element) comes from a snapshot of an allowed window,
    learned from the snapshots this guard itself ran;
  - list-windows is filtered to the task's windows, so other windows' titles never reach the agent.

A refusal is an ordinary agent-desktop style envelope with ok:false, a code and a suggestion.
"""
import json
import os
import re
import subprocess
import sys

REAL = os.environ.get("BENCH_AD_BIN", "agent-desktop")
GUARD_FILE = os.environ.get("BENCH_GUARD_FILE", "")
VERBS = {"snapshot", "find", "get", "is", "click", "type", "set-value", "clear", "focus", "select", "toggle", "check",
         "uncheck", "expand", "collapse", "scroll", "scroll-to", "press", "wait", "list-windows", "skills", "version"}
NEEDS_WINDOW = {"snapshot", "find", "press"}
SURFACES_OK = {"window", "menubar", "menu", "sheet", "popover", "alert"}
REF = re.compile(r"@(s[0-9A-Za-z]+):e\d+")


def refuse(message, suggestion="Use only the window ids you were given, and refs from your own snapshots of them."):
    print(json.dumps({"ok": False, "error": {"code": "guard_refused", "message": message, "retry": "never",
                                              "suggestion": suggestion}}))
    sys.exit(2)


def norm(w):
    return w if str(w).startswith("w-") else f"w-{w}"


def load():
    try:
        with open(GUARD_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        refuse("the guard has no task file", "Run this through the benchmark harness.")


def save(state):
    tmp = GUARD_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(state, fh)
    os.replace(tmp, GUARD_FILE)


def check(args, state):
    if not args or args[0] not in VERBS:
        refuse(f"command {args[0] if args else '(none)'} is not allowed", "Allowed: " + ", ".join(sorted(VERBS)))
    verb = args[0]
    allowed = {norm(w) for w in state.get("windows", [])}
    seen_window = False
    i = 1
    while i < len(args):
        a = args[i]
        val = args[i + 1] if i + 1 < len(args) else ""
        if a in ("--app",) or a.startswith("--app="):
            refuse("--app is not allowed: it can reach any window of that app", "Name the window with --window-id.")
        if a == "--headed":
            refuse("--headed is not allowed: it takes focus and the pointer", "Run without --headed.")
        if a == "--window-id" or a.startswith("--window-id="):
            w = norm(a.split("=", 1)[1] if "=" in a else val)
            if w not in allowed:
                refuse(f"window {w} is not one of this task's windows")
            seen_window = True
        if a == "--surface" or a.startswith("--surface="):
            s = a.split("=", 1)[1] if "=" in a else val
            if s not in SURFACES_OK:
                refuse(f"surface {s} is not allowed")
        i += 1
    for m in REF.finditer(" ".join(args)):
        if m.group(1) not in set(state.get("snapshots", [])):
            refuse(f"ref {m.group(0)} does not come from a snapshot of this task's windows",
                   "Take a snapshot of your window and use the refs it prints.")
    if verb in NEEDS_WINDOW and not seen_window:
        refuse(f"{verb} must name a window with --window-id")


def main():
    args = sys.argv[1:]
    state = load()
    if args and args[0] in ("skills", "version"):
        os.execvp(REAL, [REAL, *args])
    check(args, state)
    p = subprocess.run([REAL, *args], capture_output=True, text=True)
    out = p.stdout
    try:
        env = json.loads(out.strip().splitlines()[-1]) if out.strip() else None
    except ValueError:
        env = None
    if env and env.get("ok"):
        data = env.get("data")
        if args[0] in ("snapshot", "find") and isinstance(data, dict) and data.get("snapshot_id"):
            state.setdefault("snapshots", []).append(data["snapshot_id"])
            save(state)
        if args[0] == "list-windows" and isinstance(data, list):
            allowed = {norm(w) for w in state.get("windows", [])}
            env["data"] = [w for w in data if w.get("id") in allowed]
            out = json.dumps(env) + "\n"
    sys.stdout.write(out)
    sys.stderr.write(p.stderr)
    sys.exit(p.returncode)


if __name__ == "__main__":
    main()
