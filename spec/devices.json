{
 "version": 1,
 "apps": [
  {
   "id": "ios-simulator",
   "label": "Simulator (iPhone, iPad, Watch, TV, Vision)",
   "kind": "simulator",
   "match": {
    "macos": { "bundle": ["com.apple.iphonesimulator"] }
   },
   "windows": [
    { "role": "main" }
   ],
   "resizes_itself": true,
   "keys": {
    "macos": { "capture": "none" }
   }
  },
  {
   "id": "android-emulator",
   "label": "Android Emulator",
   "kind": "emulator",
   "match": {
    "macos": { "process": ["qemu-system-*", "emulator", "emulator64-*"] },
    "linux": { "class": ["emulator", "emulator64-*", "qemu-system-*"], "process": ["qemu-system-*", "emulator", "emulator64-*"] },
    "windows": { "exe": ["qemu-system-*", "emulator.exe"] }
   },
   "windows": [
    { "title_prefix": "Android Emulator", "role": "main" },
    { "role": "companion" }
   ],
   "resizes_itself": true,
   "float": true,
   "keys": {
    "macos": { "capture": "none" },
    "linux": { "capture": "none" },
    "windows": { "capture": "none" }
   }
  },
  {
   "id": "utm",
   "label": "UTM",
   "kind": "vm",
   "match": {
    "macos": { "bundle": ["com.utmapp.UTM"] }
   },
   "windows": [
    { "role": "main" }
   ],
   "resizes_itself": true,
   "keys": {
    "macos": { "capture": "tap", "release": "Control+Option" }
   }
  },
  {
   "id": "parallels",
   "label": "Parallels Desktop",
   "kind": "vm",
   "match": {
    "macos": { "bundle": ["com.parallels.desktop.console"], "process": ["prl_client_app", "prl_vm_app"] }
   },
   "windows": [
    { "role": "main" }
   ],
   "resizes_itself": true,
   "keys": {
    "macos": { "capture": "tap", "release": "Control+Option" }
   }
  },
  {
   "id": "vmware-fusion",
   "label": "VMware Fusion",
   "kind": "vm",
   "match": {
    "macos": { "bundle": ["com.vmware.fusion"], "process": ["vmware-vmx"] },
    "windows": { "exe": ["vmware.exe", "vmware-vmx.exe"] }
   },
   "windows": [
    { "role": "main" }
   ],
   "resizes_itself": true,
   "keys": {
    "macos": { "capture": "tap", "release": "Control+Command" },
    "windows": { "capture": "hook", "release": "Control+Alt" }
   }
  },
  {
   "id": "virtualbox",
   "label": "VirtualBox",
   "kind": "vm",
   "match": {
    "macos": { "bundle": ["org.virtualbox.app.VirtualBoxVM", "org.virtualbox.app.VirtualBox"] },
    "windows": { "exe": ["VirtualBoxVM.exe", "VirtualBox.exe"] }
   },
   "windows": [
    { "role": "main" }
   ],
   "resizes_itself": true,
   "keys": {
    "macos": { "capture": "tap", "release": "Left Command (the Host key)" },
    "windows": { "capture": "hook", "release": "Right Control (the Host key)" }
   }
  },
  {
   "id": "tart",
   "label": "Tart VM window",
   "kind": "vm",
   "match": {
    "macos": { "process": ["tart"] }
   },
   "windows": [
    { "title_prefix": "bsx-", "role": "main", "home": "agent" },
    { "role": "main" }
   ],
   "resizes_itself": true,
   "keys": {
    "macos": { "capture": "none", "note": "keys are captured only with `tart run --capture-system-keys`" }
   }
  },
  {
   "id": "virt-viewer",
   "label": "virt-manager, virt-viewer, remote-viewer",
   "kind": "vm",
   "match": {
    "linux": { "class": ["virt-manager", "virt-viewer", "remote-viewer", "org.virt-manager.virt-manager"] }
   },
   "windows": [
    { "role": "main" }
   ],
   "resizes_itself": true,
   "keys": {
    "linux": { "capture": "inhibit", "release": "Control+Alt" }
   }
  },
  {
   "id": "gnome-boxes",
   "label": "GNOME Boxes",
   "kind": "vm",
   "match": {
    "linux": { "class": ["org.gnome.Boxes", "gnome-boxes"] }
   },
   "windows": [
    { "role": "main" }
   ],
   "resizes_itself": true,
   "keys": {
    "linux": { "capture": "inhibit", "release": "Control+Alt" }
   }
  },
  {
   "id": "hyperv",
   "label": "Hyper-V Virtual Machine Connection",
   "kind": "vm",
   "match": {
    "windows": { "exe": ["vmconnect.exe"] }
   },
   "windows": [
    { "role": "main" }
   ],
   "resizes_itself": true,
   "keys": {
    "windows": { "capture": "hook", "release": "Control+Alt+Left Arrow", "note": "vmconnect sends Windows key combinations to the guest only when its Local Resources setting says so" }
   }
  }
 ]
}
