[
 {
  "name": "a child of the process BaneySpaces started is the agent's",
  "rules": [
   "R-D8"
  ],
  "roots": {
   "100": 5
  },
  "starts": {
   "100": 5,
   "200": 6
  },
  "parents": {
   "200": 100
  },
  "pid": 200,
  "expect": true
 },
 {
  "name": "a grandchild too: the emulator's qemu",
  "rules": [
   "R-D8"
  ],
  "roots": {
   "100": 5
  },
  "starts": {
   "100": 5,
   "200": 6,
   "300": 7
  },
  "parents": {
   "200": 100,
   "300": 200
  },
  "pid": 300,
  "expect": true
 },
 {
  "name": "the root itself",
  "rules": [
   "R-D8"
  ],
  "roots": {
   "100": 5
  },
  "starts": {
   "100": 5
  },
  "parents": {},
  "pid": 100,
  "expect": true
 },
 {
  "name": "an unrelated process is not",
  "rules": [
   "R-D8"
  ],
  "roots": {
   "100": 5
  },
  "starts": {
   "100": 5,
   "400": 8
  },
  "parents": {
   "400": 1
  },
  "pid": 400,
  "expect": false
 },
 {
  "name": "a pid reused by another process is not a root any more",
  "rules": [
   "R-D8"
  ],
  "roots": {
   "100": 5
  },
  "starts": {
   "100": 9,
   "300": 10
  },
  "parents": {
   "300": 100
  },
  "pid": 300,
  "expect": false
 },
 {
  "name": "a parent loop ends",
  "rules": [
   "R-D8"
  ],
  "roots": {
   "100": 5
  },
  "starts": {
   "100": 5,
   "500": 6,
   "501": 6
  },
  "parents": {
   "500": 501,
   "501": 500
  },
  "pid": 500,
  "expect": false
 },
 {
  "name": "launchd is never a root's parent for anyone",
  "rules": [
   "R-D8"
  ],
  "roots": {
   "100": 5
  },
  "starts": {
   "100": 5,
   "600": 6
  },
  "parents": {
   "600": 1
  },
  "pid": 600,
  "expect": false
 }
