[
 {
  "name": "the switch chord runs in a VM that taps system keys",
  "rules": [
   "R-D7"
  ],
  "platform": "macos",
  "mod": "cmd",
  "bridge": true,
  "front": "utm",
  "chord": {
   "mods": [
    "cmd"
   ],
   "key": "3"
  },
  "expect": "switch 3"
 },
 {
  "name": "the move chord too",
  "rules": [
   "R-D7"
  ],
  "platform": "macos",
  "mod": "cmd",
  "bridge": true,
  "front": "parallels",
  "chord": {
   "mods": [
    "cmd",
    "shift"
   ],
   "key": "7"
  },
  "expect": "move 7"
 },
