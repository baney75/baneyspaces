 },
 {
  "name": "BaneySpaces' sandbox view (a Tart window named bsx-...) is pinned to the agent workspace",
  "rules": [
   "R-D1",
   "R-D9"
  ],
  "facts": {
   "platform": "macos",
   "title": "bsx-s-ba0365d2",
   "standard": true,
   "process": "tart"
  },
  "expect": {
   "app": "tart",
   "role": "main",
   "agent_home": true
  }
 },
 {
  "name": "your own Tart VM window is not pinned",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "macos",
   "title": "my-dev-vm",
   "standard": true,
   "process": "tart"
  },
  "expect": {
   "app": "tart",
   "role": "main",
   "agent_home": false
  }
 },
 {
  "name": "virt-manager and virt-viewer on Linux",
  "rules": [
