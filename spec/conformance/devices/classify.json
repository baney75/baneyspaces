[
 {
  "name": "the Simulator's device window is a main window that resizes itself",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "macos",
   "title": "iPhone 17 Pro \u2013 iOS 26.5",
   "standard": true,
   "bundle": "com.apple.iphonesimulator"
  },
  "expect": {
   "app": "ios-simulator",
   "role": "main",
   "resizes_itself": true
  }
 },
 {
  "name": "the Simulator's iPad window",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "macos",
   "title": "iPad Pro 13-inch (M5) \u2013 iPadOS 27.0",
   "standard": true,
   "bundle": "com.apple.iphonesimulator"
  },
  "expect": {
   "app": "ios-simulator",
   "role": "main"
  }
 },
 {
  "name": "a sheet or panel of the Simulator is not a window",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "macos",
   "title": "",
   "standard": false,
   "bundle": "com.apple.iphonesimulator"
  },
  "expect": {
   "app": "ios-simulator",
   "role": "ignore"
  }
 },
 {
  "name": "the Android emulator's device window (macOS, by process)",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "macos",
   "title": "Android Emulator - Pixel_9_API_35:5554",
   "standard": true,
   "process": "qemu-system-aarch64",
   "args": [
    "-avd",
    "Pixel_9_API_35"
   ]
  },
  "expect": {
   "app": "android-emulator",
   "role": "main",
   "float": true,
   "resizes_itself": true
  }
 },
 {
  "name": "the emulator's toolbar is a companion even as a panel",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "macos",
   "title": "",
   "standard": false,
   "process": "qemu-system-aarch64",
   "args": [
    "-avd",
    "Pixel_9_API_35"
   ]
  },
  "expect": {
   "app": "android-emulator",
   "role": "companion"
  }
 },
 {
  "name": "the emulator's Extended controls window is a companion even when it is a standard window",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "macos",
   "title": "Extended Controls - Pixel_9_API_35:5554",
   "standard": true,
   "process": "qemu-system-aarch64",
   "args": [
    "-avd",
    "Pixel_9_API_35"
   ]
  },
  "expect": {
   "app": "android-emulator",
   "role": "companion"
  }
 },
 {
  "name": "the emulator on Linux is found by its window class",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "linux",
   "title": "Extended Controls",
   "standard": true,
   "class": "Emulator"
  },
  "expect": {
   "app": "android-emulator",
   "role": "companion"
  }
 },
 {
  "name": "the emulator on Linux, main window",
  "rules": [
   "R-D1",
   "R-D10"
  ],
  "facts": {
   "platform": "linux",
   "title": "Android Emulator - Pixel_9:5554",
   "standard": true,
   "class": "emulator64-crash"
  },
  "expect": {
   "app": "android-emulator",
   "role": "main",
   "float": true
  }
 },
 {
  "name": "the emulator on Windows is found by its executable",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "windows",
   "title": "Android Emulator - Pixel_9:5554",
   "standard": true,
   "exe": "emulator.exe"
  },
  "expect": {
   "app": "android-emulator",
   "role": "main"
  }
 },
 {
  "name": "UTM's VM window",
  "rules": [
   "R-D1"
  ],
  "facts": {
   "platform": "macos",
   "title": "Ubuntu",
   "standard": true,
   "bundle": "com.utmapp.UTM"
  },
  "expect": {
   "app": "utm",
   "role": "main",
   "resizes_itself": true
  }
 },
 {
