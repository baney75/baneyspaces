[
  {
    "name": "a hook an agent sets is pending and inert",
    "steps": [
      {
        "do": "set",
        "path": "hooks.on_switch",
        "value": "echo hi",
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "hooks.on_switch"
        ],
        "effective": {
          "hooks.on_switch": ""
        },
        "configured": {
          "hooks.on_switch": "echo hi"
        },
        "resolved": {
          "/pending/0/written_by_hint": "agent:x",
          "/pending/0/kind": "hook"
        }
      }
    ]
  },
  {
    "name": "a hook the user sets by hand is pending too",
    "steps": [
      {
        "do": "edit_file",
        "toml": "[hooks]\non_window_open = \"touch /tmp/x\"\n",
        "expect": "ok",
        "pending": [
          "hooks.on_window_open"
        ],
        "effective": {
          "hooks.on_window_open": ""
        },
        "resolved": {
          "/pending/0/written_by_hint": null
        }
      }
    ]
  },
  {
    "name": "a binding that runs a command is pending and not bound",
    "steps": [
      {
        "do": "set",
        "path": "keys.bindings.mod+h",
        "value": "exec foot",
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "keys.bindings.\"mod+h\""
        ],
        "absent": [
          "keys.bindings.mod+h"
        ],
        "configured": {
          "keys.bindings.mod+h": "exec foot"
        }
      },
      {
        "do": "check",
        "effective": {
          "keys.bindings.mod+1": "switch 1"
        }
      }
    ]
  },
  {
    "name": "bindings to config, theme and agent run commands are pending",
    "steps": [
      {
        "do": "apply",
        "doc": {
          "keys": {
            "bindings": {
              "mod+k": "config set theme.name minimal",
              "mod+l": "theme set minimal",
              "mod+y": "agent run -- sh -c 'x'"
            }
          }
        },
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "keys.bindings.\"mod+k\"",
          "keys.bindings.\"mod+l\"",
          "keys.bindings.\"mod+y\""
        ],
        "absent": [
          "keys.bindings.mod+k",
          "keys.bindings.mod+l",
          "keys.bindings.mod+y"
        ]
      }
    ]
  },
  {
    "name": "a command bound inside a mode is pending",
    "steps": [
      {
        "do": "apply",
        "doc": {
          "keys": {
            "bindings": {
              "mod+m": "mode nav"
            },
            "modes": {
              "nav": {
                "x": "exec true",
                "y": "switch 2"
              }
            }
          }
        },
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "keys.modes.nav.x"
        ],
        "absent": [
          "keys.modes.nav.x"
        ],
        "effective": {
          "keys.modes.nav.y": "switch 2",
          "keys.modes.nav.escape": "mode default"
        }
      }
    ]
  },
  {
    "name": "plain actions, themes, animation and behavior stay free for an agent",
    "steps": [
      {
        "do": "set",
        "path": "keys.bindings.mod+j",
        "value": "move 2",
        "caller": "agent:x",
        "expect": "ok",
        "pending": [],
        "effective": {
          "keys.bindings.mod+j": "move 2"
        }
      },
      {
        "do": "set",
        "path": "keys.bindings.mod+u",
        "value": "overview",
        "caller": "agent:x",
        "expect": "ok",
        "pending": []
      },
      {
        "do": "set",
        "path": "keys.bindings.mod+i",
        "value": "agent-workspace toggle",
        "caller": "agent:x",
        "expect": "ok",
        "pending": []
      },
      {
        "do": "set",
        "path": "theme.name",
        "value": "minimal",
        "caller": "agent:x",
        "expect": "ok",
        "pending": [],
        "effective": {
          "theme.name": "minimal"
        }
      },
      {
        "do": "set",
        "path": "animation.preset",
        "value": "omarchy",
        "caller": "agent:x",
        "expect": "ok",
        "pending": []
      },
      {
        "do": "set",
        "path": "behavior.follow_focus",
        "value": false,
        "caller": "agent:x",
        "expect": "ok",
        "pending": [],
        "effective": {
          "behavior.follow_focus": false
        }
      },
      {
        "do": "set",
        "path": "rules",
        "value": [
          {
            "app": "foot",
            "workspace": 3
          }
        ],
        "caller": "agent:x",
        "expect": "ok",
        "pending": []
      }
    ]
  },
  {
    "name": "an approval is per entry, keyed by path and value, and a changed value is pending again",
    "steps": [
      {
        "do": "apply",
        "doc": {
          "hooks": {
            "on_switch": "echo a"
          },
          "keys": {
            "bindings": {
              "mod+h": "exec foot"
            }
          }
        },
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "hooks.on_switch",
          "keys.bindings.\"mod+h\""
        ]
      },
      {
        "do": "approve",
        "path": "hooks.on_switch",
        "value": "echo a",
        "pending": [
          "keys.bindings.\"mod+h\""
        ],
        "effective": {
          "hooks.on_switch": "echo a"
        }
      },
      {
        "do": "set",
        "path": "hooks.on_switch",
        "value": "echo a; echo b",
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "hooks.on_switch",
          "keys.bindings.\"mod+h\""
        ],
        "effective": {
          "hooks.on_switch": ""
        }
      },
      {
        "do": "set",
        "path": "hooks.on_switch",
        "value": "echo a",
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "keys.bindings.\"mod+h\""
        ],
        "effective": {
          "hooks.on_switch": "echo a"
        }
      },
      {
        "do": "approve",
        "path": "keys.bindings.\"mod+h\"",
        "value": "exec foot",
        "pending": []
      },
      {
        "do": "set",
        "path": "keys.bindings.mod+h",
        "value": "exec foot -e sh",
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "keys.bindings.\"mod+h\""
        ]
      }
    ]
  },
  {
    "name": "the same command on another path is another entry",
    "steps": [
      {
        "do": "set",
        "path": "keys.bindings.mod+h",
        "value": "exec foot",
        "caller": "agent:x",
        "expect": "ok"
      },
      {
        "do": "approve",
        "path": "keys.bindings.\"mod+h\"",
        "value": "exec foot",
        "pending": []
      },
      {
        "do": "set",
        "path": "keys.bindings.mod+g",
        "value": "exec foot",
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "keys.bindings.\"mod+g\""
        ]
      }
    ]
  },
  {
    "name": "privileged commands wait for a click too: stop, lend, return, keys and pointer",
    "steps": [
      {
        "do": "apply",
        "doc": {
          "keys": {
            "bindings": {
              "mod+z": "stop",
              "mod+q": "agent lend @sa:e1",
              "mod+w": "agent return @sa:e1",
              "mod+p": "agent press @sa:e1 Return"
            }
          }
        },
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "keys.bindings.\"mod+z\"",
          "keys.bindings.\"mod+q\"",
          "keys.bindings.\"mod+w\"",
          "keys.bindings.\"mod+p\""
        ],
        "absent": [
          "keys.bindings.mod+z",
          "keys.bindings.mod+q",
          "keys.bindings.mod+w",
          "keys.bindings.mod+p"
        ]
      }
    ]
  },
  {
    "name": "the plain actions are an allowlist: moving around and showing things stay free",
    "steps": [
      {
        "do": "apply",
        "doc": {
          "keys": {
            "bindings": {
              "mod+a": "switch 2",
              "mod+b": "move 3 --stay",
              "mod+c": "focus-monitor DP-1",
              "mod+d": "overview",
              "mod+e": "launcher",
              "mod+f": "switcher apps",
              "mod+g": "window resize 10 0",
              "mod+i": "agent-workspace toggle",
              "mod+j": "agent status",
              "mod+k": "agent log",
              "mod+l": "ls",
              "mod+n": "keys"
            }
          }
        },
        "caller": "agent:x",
        "expect": "ok",
        "pending": []
      }
    ]
  },
  {
    "name": "a pending binding that replaces a default leaves the default bound",
    "steps": [
      {
        "do": "set",
        "path": "keys.bindings.super+1",
        "value": "exec foot",
        "caller": "agent:x",
        "expect": "ok",
        "pending": [
          "keys.bindings.\"super+1\""
        ],
        "effective": {
          "keys.bindings.mod+1": "switch 1"
        },
        "absent": [
          "keys.bindings.super+1"
        ]
      },
      {
        "do": "approve",
        "path": "keys.bindings.\"super+1\"",
        "value": "exec foot",
        "pending": [],
        "effective": {
          "keys.bindings.super+1": "exec foot"
        },
        "absent": [
          "keys.bindings.mod+1"
        ]
      }
    ]
  },
  {
    "name": "no command approves (user)",
    "steps": [
      {
        "do": "set",
        "path": "hooks.on_switch",
        "value": "echo hi",
        "caller": "user",
        "expect": "ok",
        "pending": [
          "hooks.on_switch"
        ]
      },
      {
        "do": "approve_by_command",
        "path": "hooks.on_switch",
        "value": "echo hi",
        "caller": "user",
        "expect": {
          "error": "not_in_scope"
        },
        "pending": [
          "hooks.on_switch"
        ],
        "effective": {
          "hooks.on_switch": ""
        }
      }
    ]
  },
  {
