[
  {
    "name": "set records the caller and a one-line summary; undo restores",
    "steps": [
      {
        "do": "set",
        "path": "keys.bindings.mod+h",
        "value": "exec foot",
        "caller": "agent:claude",
        "expect": "ok",
        "effective": {
          "keys.bindings.mod+h": "exec foot"
        },
        "history": {
          "len": 2,
          "callers": [
            "agent:claude",
            "system"
          ]
        }
      },
      {
        "do": "undo",
        "expect": "ok",
        "history": {
          "len": 1
        },
        "file": ""
      },
      {
        "do": "check",
        "effective": {
          "keys.bindings.mod+1": "switch 1"
        }
      }
    ]
  },
  {
    "name": "undo n steps back n versions",
    "steps": [
      {
        "do": "set",
        "path": "animation.speed",
        "value": 0.5,
        "expect": "ok"
      },
      {
        "do": "set",
        "path": "behavior.follow_focus",
        "value": false,
        "expect": "ok"
      },
      {
        "do": "set",
        "path": "animation.respect_reduce_motion",
        "value": false,
        "caller": "settings",
        "expect": "ok",
        "history": {
          "callers": [
            "settings",
            "user",
            "user",
            "system"
          ]
        }
      },
      {
        "do": "undo",
        "n": 2,
        "expect": "ok",
        "effective": {
          "animation.speed": 0.5,
          "behavior.follow_focus": true,
          "animation.respect_reduce_motion": true
        },
        "history": {
          "len": 2
        }
      },
      {
        "do": "undo",
        "n": 5,
        "expect": {
          "error": "invalid_args"
        }
      }
    ]
  },
  {
    "name": "nothing to undo",
    "steps": [
      {
        "do": "undo",
        "expect": {
          "error": "not_found"
        }
      }
    ]
  },
