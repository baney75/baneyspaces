  {
    "name": "unset puts a setting back to its default",
    "steps": [
      {
        "do": "set",
        "path": "behavior.dock.edge",
        "value": "left",
        "expect": "ok",
        "effective": {
          "behavior.dock.edge": "left"
        }
      },
      {
        "do": "unset",
        "path": "behavior.dock.edge",
        "expect": "ok",
        "effective": {
          "behavior.dock.edge": "bottom"
        },
        "file": ""
      }
    ]
  },
  {
    "name": "reset one section leaves the others",
    "steps": [
      {
        "do": "set",
        "path": "keys.bindings.mod+h",
        "value": "exec foot",
        "expect": "ok"
      },
      {
        "do": "set",
        "path": "animation.speed",
        "value": 0.5,
        "expect": "ok"
      },
      {
        "do": "reset",
        "section": "keys",
        "expect": "ok",
        "effective": {
          "animation.speed": 0.5
        },
        "file": "[animation]\nspeed = 0.5\n"
      },
      {
        "do": "reset",
        "expect": "ok",
        "effective": {
          "animation.speed": 1.0
        },
        "file": ""
      }
    ]
  },
  {
    "name": "a hand edit is applied and recorded as the user",
    "steps": [
      {
        "do": "edit_file",
        "toml": "# mine\n[animation]\nspeed = 0.8\n",
        "expect": "ok",
        "effective": {
          "animation.speed": 0.8
        },
        "history": {
          "callers": [
            "user"
          ]
        }
      }
    ]
  },
  {
    "name": "an invalid hand edit keeps the last good config running",
    "steps": [
      {
        "do": "set",
        "path": "animation.speed",
        "value": 0.5,
        "expect": "ok"
      },
      {
        "do": "edit_file",
        "toml": "[animation]\nspeed = \"fast\"\n",
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "animation.speed",
              "code": "type"
            }
          ]
        },
        "effective": {
          "animation.speed": 0.5
        },
        "history": {
          "len": 2
        }
      },
      {
        "do": "set",
        "path": "behavior.follow_focus",
        "value": false,
        "expect": {
          "error": "config_invalid"
        }
      },
      {
        "do": "reset",
        "section": "animation",
        "expect": "ok",
        "effective": {
          "animation.speed": 1.0
        }
      }
    ]
  },
  {
    "name": "apply replaces the whole document as one change",
    "steps": [
      {
        "do": "apply",
        "doc": {
          "behavior": {
            "follow_focus": false
          }
        },
        "expect": "ok"
      },
      {
        "do": "apply",
        "doc": {
          "animation": {
            "speed": 0.7
          }
        },
        "expect": "ok",
        "effective": {
          "behavior.follow_focus": true,
          "animation.speed": 0.7
        },
        "history": {
          "len": 3
        }
      },
      {
        "do": "apply",
        "doc": {
          "animation": {
            "speed": 0.7
          }
        },
        "expect": "ok",
        "history": {
          "len": 3
        }
      }
    ]
  },
  {
    "name": "themes: create, set, refuse to delete the one in use, delete, undo",
    "steps": [
      {
        "do": "theme_create",
        "name": "mine",
        "extends": "omarchy",
        "tokens": {
          "radius": {
            "tile": 3
          }
        },
        "caller": "agent:t",
        "expect": "ok"
      },
      {
        "do": "theme_set",
        "name": "mine",
        "expect": "ok",
        "effective": {
          "theme.name": "mine"
        },
        "resolved": {
          "/resolved/theme/tokens/radius/tile": 3,
          "/resolved/theme/chain/0": "omarchy"
        }
      },
      {
        "do": "theme_delete",
        "name": "mine",
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "theme.name"
            }
          ]
        }
      },
      {
        "do": "theme_delete",
        "name": "omarchy",
        "expect": {
          "error": "invalid_args"
        }
      },
      {
        "do": "theme_set",
        "name": "minimal",
        "expect": "ok"
      },
      {
        "do": "theme_delete",
        "name": "mine",
        "expect": "ok"
      },
      {
        "do": "theme_delete",
        "name": "mine",
        "expect": {
          "error": "not_found"
        }
      }
    ]
  }
]
