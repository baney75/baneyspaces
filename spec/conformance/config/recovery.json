  {
    "name": "the recovery chord cannot be bound (super+shift+escape = exec true)",
    "steps": [
      {
        "do": "validate",
        "doc": {
          "keys": {
            "bindings": {
              "super+shift+escape": "exec true"
            }
          }
        },
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "keys.bindings.\"super+shift+escape\"",
              "code": "reserved_chord"
            }
          ]
        }
      }
    ]
  },
