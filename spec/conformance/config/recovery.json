  {
    "name": "another chord with the same key is a different chord",
    "steps": [
      {
        "do": "apply",
        "doc": {
          "keys": {
            "bindings": {
              "super+shift+ctrl+escape": "exec true"
            }
          }
        },
        "expect": "ok"
      }
    ]
  },
  {
    "name": "config reset keys and reset theme restore the defaults (what the recovery chord runs)",
    "steps": [
      {
        "do": "set",
        "path": "keys.bindings.mod+1",
        "value": "exec true",
        "caller": "agent:x",
        "expect": "ok"
      },
      {
        "do": "set",
        "path": "theme.name",
        "value": "minimal",
        "caller": "agent:x",
        "expect": "ok"
      },
      {
        "do": "set",
        "path": "animation.speed",
        "value": 0.5,
        "expect": "ok"
      },
      {
        "do": "reset",
        "section": "keys",
        "caller": "user",
        "expect": "ok",
        "effective": {
          "keys.bindings.mod+1": "switch 1"
        }
      },
      {
        "do": "reset",
        "section": "theme",
        "caller": "user",
        "expect": "ok",
        "effective": {
          "theme.name": "baneyspaces",
          "animation.speed": 0.5
        },
        "history": {
          "callers": [
            "user",
            "user",
            "user",
            "agent:x",
            "agent:x",
            "system"
          ]
        }
      }
    ]
  }
