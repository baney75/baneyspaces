[
  {
    "name": "the recovery chord on linux is super+shift+escape, held 2000 ms",
    "platform": "linux",
    "steps": [
      {
        "do": "recovery",
        "data": {
          "chord": "super+shift+escape",
          "hold_ms": 2000
        }
      }
    ]
  },
