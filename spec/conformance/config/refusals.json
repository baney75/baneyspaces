  {
    "name": "a custom theme in use that extends nothing known",
    "steps": [
      {
        "do": "validate",
        "doc": {
          "theme": {
            "name": "bad"
          }
        },
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "themes.bad.extends",
              "code": "bad_theme"
            }
          ]
        }
      }
    ],
    "themes": {
      "bad": {
        "extends": "ghost"
      }
    }
  },
  {
    "name": "two themes that extend each other",
    "steps": [
      {
        "do": "validate",
        "doc": {
          "theme": {
            "name": "a"
          }
        },
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "theme.name",
              "code": "bad_theme"
            }
          ]
        }
      }
    ],
    "themes": {
      "a": {
        "extends": "b"
      },
      "b": {
        "extends": "a"
      }
    }
  },
  {
    "name": "a document that is not toml",
    "steps": [
      {
        "do": "apply",
        "toml": "[keys",
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "",
              "code": "syntax"
            }
          ]
        }
      }
    ]
  },
  {
    "name": "a refused change leaves the running config and the file alone",
    "steps": [
      {
        "do": "set",
        "path": "animation.speed",
        "value": 0.5,
        "expect": "ok",
        "history": {
          "len": 2
        }
      },
      {
        "do": "set",
        "path": "animation.dock.in.duration_ms",
        "value": 5000,
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "animation.dock.in.duration_ms"
            }
          ]
        },
        "effective": {
          "animation.speed": 0.5
        },
        "history": {
          "len": 2
        },
        "file": "[animation]\nspeed = 0.5\n"
      }
    ]
  },
  {
    "name": "a custom palette in use must be complete",
    "steps": [
      {
        "do": "validate",
        "doc": {
          "theme": {
            "palette": "bad"
          }
        },
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "themes.bad.palette.accent",
              "code": "required"
            }
          ]
        }
      }
    ],
    "themes": {
      "bad": {
        "extends": "omarchy",
        "palette": {
          "background": "#111111"
        }
      }
    }
  }
]
