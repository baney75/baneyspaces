[
  {
    "name": "an unknown setting is refused with its path and a hint",
    "steps": [
      {
        "do": "validate",
        "doc": {
          "keyz": {}
        },
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "keyz",
              "code": "unknown_key"
            }
          ]
        }
      }
    ]
  },
  {
    "name": "an unknown nested setting",
    "steps": [
      {
        "do": "validate",
        "doc": {
          "behavior": {
            "dock": {
