  {
    "name": "an animation over 1000 ms is refused",
    "steps": [
      {
        "do": "validate",
        "doc": {
          "animation": {
            "dock": {
              "in": {
                "duration_ms": 1001
              }
            }
          }
        },
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "animation.dock.in.duration_ms",
              "code": "range"
            }
          ]
        }
      }
    ]
  },
  {
    "name": "exactly 1000 ms is the most (the over-1000 case above is the refusal)",
    "steps": [
      {
        "do": "validate",
        "doc": {
          "animation": {
            "dock": {
              "in": {
                "curve": "linear",
                "duration_ms": 1000
              }
            },
            "speed": 1.5
          }
        },
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "animation.dock.in.duration_ms",
              "code": "too_long"
            }
          ]
        }
      }
    ]
  },
  {
    "name": "speed can push a preset over 1000 ms",
    "steps": [
      {
        "do": "validate",
        "doc": {
          "animation": {
            "preset": "omarchy",
            "speed": 2.5
          }
        },
        "expect": {
          "error": "config_invalid",
          "issues": [
            {
              "path": "animation.border.duration_ms",
              "code": "too_long"
            }
          ]
        }
      }
    ]
  },
