[
 {
  "name": "switch changes only the monitor you are on",
  "rules": [
   "R-S1",
   "R-S2"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "monitor_added",
    "monitor": "B"
   },
   {
    "do": "switch",
    "n": 4,
    "effects": [
     {
      "do": "show_workspace",
      "monitor": "A",
      "workspace": 4
     }
    ],
    "expect": {
     "monitors": {
      "A": {
       "current": 4
      },
      "B": {
       "current": 1
      }
     }
    }
   }
  ]
 },
 {
  "name": "switch acts on the monitor you moved to",
  "rules": [
   "R-S2"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "monitor_added",
    "monitor": "B"
   },
   {
    "do": "observe_focus_monitor",
    "monitor": "B"
   },
   {
    "do": "switch",
    "n": 6,
    "effects": [
     {
      "do": "show_workspace",
      "monitor": "B",
      "workspace": 6
     }
    ],
    "expect": {
     "focused_monitor": "B",
     "monitors": {
      "A": {
       "current": 1
      },
      "B": {
       "current": 6
      }
     }
    }
   }
  ]
 },
 {
  "name": "a switch can name its monitor and leaves your focus alone",
  "rules": [
   "R-S2"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "monitor_added",
    "monitor": "B"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "switch",
    "n": 3,
    "monitor": "B",
    "effects": [
     {
      "do": "show_workspace",
      "monitor": "B",
      "workspace": 3
     }
    ],
    "expect": {
     "focused_monitor": "A",
     "active": "w1",
     "monitors": {
      "B": {
       "current": 3
      }
     }
    }
   }
  ]
 },
 {
  "name": "switching to the workspace you are on does nothing",
  "rules": [
   "R-S3"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "switch",
    "n": 1,
    "effects": [],
    "expect": {
     "active": "w1"
    }
   }
  ]
 },
 {
  "name": "workspaces 1 to 9 all work",
  "rules": [
   "R-S1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "switch",
    "n": 2,
    "expect": {
     "monitors": {
      "A": {
       "current": 2
      }
     }
    }
   },
   {
    "do": "switch",
    "n": 3,
    "expect": {
     "monitors": {
      "A": {
       "current": 3
      }
     }
    }
   },
   {
    "do": "switch",
    "n": 4,
    "expect": {
     "monitors": {
      "A": {
       "current": 4
      }
     }
    }
   },
   {
    "do": "switch",
    "n": 5,
    "expect": {
     "monitors": {
      "A": {
       "current": 5
      }
     }
    }
   },
   {
    "do": "switch",
    "n": 6,
    "expect": {
     "monitors": {
      "A": {
       "current": 6
      }
     }
    }
   },
   {
    "do": "switch",
    "n": 7,
    "expect": {
     "monitors": {
      "A": {
       "current": 7
      }
     }
    }
   },
   {
    "do": "switch",
    "n": 8,
    "expect": {
     "monitors": {
      "A": {
       "current": 8
      }
     }
    }
   },
   {
    "do": "switch",
    "n": 9,
    "expect": {
     "monitors": {
      "A": {
       "current": 9
      }
     }
    }
   }
  ]
 },
 {
  "name": "workspace 0 and 10 are refused",
  "rules": [
   "R-S1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "switch",
    "n": 0,
    "error": "invalid_args"
   },
   {
    "do": "switch",
    "n": 10,
    "error": "invalid_args"
   },
   {
    "expect": {
     "monitors": {
      "A": {
       "current": 1
      }
     }
    }
   }
  ]
 },
 {
  "name": "a switch to an unknown monitor is refused",
  "rules": [
   "R-S2"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "switch",
    "n": 2,
    "monitor": "Z",
    "error": "not_found"
   }
  ]
 },
 {
  "name": "switch puts back the window you had in front there",
  "rules": [
   "R-S4"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "open",
    "window": "w2",
    "pid": 2,
    "app": "foot"
   },
   {
    "do": "activate",
    "window": "w1"
   },
   {
    "do": "switch",
    "n": 2
   },
   {
    "do": "switch",
    "n": 1,
    "effects": [
     {
      "do": "show_workspace",
      "monitor": "A",
      "workspace": 1
     },
     {
      "do": "focus_window",
      "window": "w1"
     }
    ],
    "expect": {
     "active": "w1"
    }
   }
  ]
 },
 {
  "name": "switch focuses the oldest window when none was in front",
  "rules": [
   "R-S4"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "switch",
    "n": 2
   },
   {
    "do": "open",
    "window": "w2",
    "pid": 2,
    "app": "foot"
   },
   {
    "do": "open",
    "window": "w3",
    "pid": 3,
    "app": "foot"
   },
   {
    "do": "switch",
    "n": 1,
    "expect": {
     "active": "w1"
    }
   },
   {
    "do": "switch",
    "n": 2,
    "expect": {
     "active": "w3"
    }
   }
  ]
 }
]
