[
 {
  "name": "move sends the front window and follows it",
  "rules": [
   "R-V1",
   "R-V3"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "move",
    "n": 3,
    "effects": [
     {
      "do": "move_window",
      "window": "w1",
      "to": "A:3"
     },
     {
      "do": "show_workspace",
      "monitor": "A",
      "workspace": 3
     },
     {
      "do": "focus_window",
      "window": "w1"
     }
    ],
    "expect": {
     "workspaces": {
      "A:3": [
       "w1"
      ],
      "A:1": []
     },
     "monitors": {
      "A": {
       "current": 3
      }
     },
     "active": "w1"
    }
   }
  ]
 },
 {
  "name": "move names its window",
  "rules": [
   "R-V1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "open",
    "window": "w2",
    "pid": 2,
    "app": "foot"
   },
   {
    "do": "move",
    "n": 5,
    "window": "w1",
    "expect": {
     "workspaces": {
      "A:5": [
       "w1"
      ],
      "A:1": [
       "w2"
      ]
     },
     "active": "w1"
    }
   }
  ]
 },
 {
  "name": "moving to the workspace it is on does nothing",
  "rules": [
   "R-V1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "move",
    "n": 1,
    "effects": []
   }
  ]
 },
 {
  "name": "moving with nothing in front is refused",
  "rules": [
   "R-V1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "move",
    "n": 2,
    "error": "not_found"
   }
  ]
 },
 {
  "name": "moving to workspace 10 is refused",
  "rules": [
   "R-V1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "move",
    "n": 10,
    "error": "invalid_args"
   }
  ]
 },
 {
  "name": "a moved window stays on its own monitor",
  "rules": [
   "R-V2"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "monitor_added",
    "monitor": "B"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot",
    "monitor": "B"
   },
   {
    "do": "observe_focus_monitor",
    "monitor": "B"
   },
   {
    "do": "move",
    "n": 7,
    "expect": {
     "workspaces": {
      "B:7": [
       "w1"
      ]
     },
     "monitors": {
      "B": {
       "current": 7
      },
      "A": {
       "current": 1
      }
     }
    }
   }
  ]
 },
 {
  "name": "moving a window on the other monitor takes you to that monitor",
  "rules": [
   "R-V3"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "monitor_added",
    "monitor": "B"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot",
    "monitor": "B"
   },
   {
    "do": "move",
    "n": 2,
    "window": "w1",
    "effects": [
     {
      "do": "move_window",
      "window": "w1",
      "to": "B:2"
     },
     {
      "do": "show_workspace",
      "monitor": "B",
      "workspace": 2
     },
     {
      "do": "focus_monitor",
      "monitor": "B"
     },
     {
      "do": "focus_window",
      "window": "w1"
     }
    ],
    "expect": {
     "focused_monitor": "B"
    }
   }
  ]
 },
 {
  "name": "move and stay leaves you, your workspace and your focus alone",
  "rules": [
   "R-V4"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "open",
    "window": "w2",
    "pid": 2,
    "app": "foot"
   },
   {
    "do": "move",
    "n": 6,
    "window": "w2",
    "follow": false,
    "effects": [
     {
      "do": "move_window",
      "window": "w2",
      "to": "A:6"
     }
    ],
    "expect": {
     "active": "w1",
     "monitors": {
      "A": {
       "current": 1
      }
     },
     "workspaces": {
      "A:6": [
       "w2"
      ],
      "A:1": [
       "w1"
      ]
     }
    }
   }
  ]
 },
 {
  "name": "move and stay of the front window falls back to this workspace",
  "rules": [
   "R-V4"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "open",
    "window": "w2",
    "pid": 2,
    "app": "foot"
   },
   {
    "do": "move",
    "n": 6,
    "follow": false,
    "expect": {
     "active": "w1",
     "monitors": {
      "A": {
       "current": 1
      }
     }
    }
   }
  ]
 },
 {
  "name": "a window you drag to another workspace stays there",
  "rules": [
   "R-V5"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1
   },
   {
    "do": "open",
    "window": "w2",
    "pid": 2
   },
   {
    "do": "observe_move",
    "window": "w2",
    "monitor": "A",
    "n": 6,
    "effects": [],
    "expect": {
     "workspaces": {
      "A:6": [
       "w2"
      ],
      "A:1": [
       "w1"
      ]
     },
     "active": "w1"
    }
   }
  ]
 },
 {
  "name": "a window dragged away from the one in front gives the front to this workspace",
  "rules": [
   "R-V5"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1
   },
   {
    "do": "open",
    "window": "w2",
    "pid": 2
   },
   {
    "do": "observe_move",
    "window": "w2",
    "monitor": "A",
    "n": 6
   },
   {
    "expect": {
     "workspaces": {
      "A:1": [
       "w1"
      ]
     }
    }
   },
   {
    "do": "observe_move",
    "window": "w1",
    "monitor": "A",
    "n": 4,
    "expect": {
     "active": null
    }
   }
  ]
 }
]
