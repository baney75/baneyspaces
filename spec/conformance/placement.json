[
 {
  "name": "new windows land where you are",
  "rules": [
   "R-P1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "switch",
    "n": 4
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "expect": {
     "workspaces": {
      "4": [
       "w1"
      ]
     },
     "active": "w1"
    }
   }
  ]
 },
 {
  "name": "a window the compositor put elsewhere is moved to where you are, silently",
  "rules": [
   "R-P1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "switch",
    "n": 4
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot",
    "workspace": 2,
    "effects": [
     {
      "do": "move_window",
      "window": "w1",
      "to": "4"
     }
    ]
   },
   {
    "expect": {
     "workspaces": {
      "4": [
       "w1"
      ],
      "2": []
     },
     "active": null
    }
   }
  ]
 },
 {
  "name": "a window joins the workspace of the display it appeared on",
  "rules": [
   "R-P1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "monitor_added",
    "monitor": "B"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot",
    "monitor": "B"
   },
   {
    "expect": {
     "workspaces": {
      "2": [
       "w1"
      ]
     },
     "active": null,
     "focused_monitor": "A"
    }
   }
  ]
 },
 {
  "name": "a window opened while you are on the second display lands there",
  "rules": [
   "R-P1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "monitor_added",
    "monitor": "B"
   },
   {
    "do": "observe_focus_monitor",
    "monitor": "B"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "expect": {
     "workspaces": {
      "2": [
       "w1"
      ]
     },
     "active": "w1"
    }
   }
  ]
 },
 {
  "name": "the same window opened twice is one window",
  "rules": [
   "R-P1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot",
    "effects": []
   },
   {
    "expect": {
     "workspaces": {
      "1": [
       "w1"
      ]
     }
    }
   }
  ]
 },
 {
  "name": "an app with a window elsewhere still opens the next one here",
  "rules": [
   "R-P1"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "open",
    "window": "w1",
    "pid": 1,
    "app": "foot"
   },
   {
    "do": "switch",
    "n": 3
   },
   {
    "do": "open",
    "window": "w2",
    "pid": 1,
    "app": "foot"
   },
   {
    "expect": {
     "workspaces": {
      "1": [
       "w1"
      ],
      "3": [
       "w2"
      ]
     },
     "active": "w2"
    }
   }
  ]
 },
 {
  "name": "a window that was already open is mirrored where it is, even out of sight",
  "rules": [
   "R-P2"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "observe_window",
    "window": "w1",
    "pid": 1,
    "workspace": 5,
    "effects": [],
    "expect": {
     "workspaces": {
      "5": [
       "w1"
      ]
     },
     "active": null
    }
   }
  ]
 },
 {
  "name": "a window already parked on the agent workspace stays parked and not drivable",
  "rules": [
   "R-P2"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "observe_window",
    "window": "w1",
    "pid": 1,
    "effects": [],
    "expect": {
     "agent": {
      "windows": [
       "w1"
      ]
     },
     "windows": {
      "w1": {
       "home": "agent",
       "agent_owned": false
      }
     }
    }
   }
  ]
 },
 {
  "name": "an agent process's window found on your workspace is moved off it",
  "rules": [
   "R-P2"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "agent_register",
    "pid": 500
   },
   {
    "do": "observe_window",
    "window": "a1",
    "pid": 500,
    "workspace": 1,
    "effects": [
     {
      "do": "move_window",
      "window": "a1",
      "to": "agent"
     }
    ],
    "expect": {
     "agent": {
      "windows": [
       "a1"
      ]
     }
    }
   }
  ]
 },
 {
  "name": "a window found at start with a reused pid stays on your workspace",
  "rules": [
   "R-P2"
  ],
  "steps": [
   {
    "do": "monitor_added",
    "monitor": "A"
   },
   {
    "do": "agent_register",
    "pid": 500,
    "start": 77
   },
   {
    "do": "observe_window",
    "window": "w1",
    "pid": 500,
    "start": 99,
    "workspace": 1,
    "effects": [],
    "expect": {
     "workspaces": {
      "1": [
       "w1"
      ]
     },
     "agent": {
      "windows": []
     }
    }
   }
  ]
 }
]
